# Port the server listens on
PORT=3000
# development or production (production enables secure cookies and trust proxy)
NODE_ENV=development
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/peerrent
# Secret for signing login tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Secret for signing admin sessions. Generate with the same command as above
SESSION_SECRET=
# Admin panel username
ADMIN_ID=
# Admin panel password (use a long, unique value)
ADMIN_PASSWORD=
# SMTP host used to send login codes
MAIL_HOST=sandbox.smtp.mailtrap.io
# SMTP port
MAIL_PORT=2525
# SMTP username
MAIL_USER=
# SMTP password
MAIL_PASS=
# Max auth requests per IP per 15 minutes
AUTH_RATE_LIMIT=20
